<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF3E4"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="center_vertical">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_medium_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔥 15 يوم تركيز متتالي"
            android:textColor="#F0813F"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_medium_coins"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="🪙 1,250 Fox Coins اليوم"
            android:textColor="#3D2817"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/widget_medium_quote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="&quot;أنت أقوى مما تعتقد!&quot;"
            android:textColor="#8A7A68"
            android:textSize="11sp"
            android:textStyle="italic" />
    </LinearLayout>

    <Button
        android:id="@+id/widget_btn_focus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="#F0813F"
        android:text="ابدأ"
        android:textColor="#FFFFFF"
        android:textSize="12sp" />
</LinearLayout>
