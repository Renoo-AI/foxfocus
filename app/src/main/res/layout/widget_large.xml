<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFBF5"
    android:orientation="vertical"
    android:padding="16dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/widget_large_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🦊 FoxFocus Dashboard"
            android:textColor="#3D2817"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_large_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="🔥 15 يوم"
            android:textColor="#FF7A29"
            android:textSize="14sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="#FFF3E4"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/widget_large_coins"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🪙 رصيد العملات الكلي: 12,450 FC"
            android:textColor="#3D2817"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_large_challenge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="🏆 التحدي الأسبوعي: 8/10 ساعات مكتملة"
            android:textColor="#8A7A68"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_large_nudge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="💡 تذكير اليوم: &quot;حافظ على تركيزك اليوم لتضمن استمرار السلسلة ورصيد العملات!&quot;"
        android:textColor="#3D2817"
        android:textSize="12sp" />

    <Button
        android:id="@+id/widget_large_btn_start"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:backgroundTint="#F0813F"
        android:text="ابدأ التركيز الآن 🚀"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
